        function verifyAdminPass(e) {
            e.preventDefault();
            const pass = document.getElementById('admin-pass-input').value.trim();
            if (!pass) return;

            if (pass === 'vietanh0910' || pass === 'vietanh910') {
                isAdminAuthenticated = true;
                currentAdminRole = 'SUPER_ADMIN';
                currentAdminWorkshop = null;
                closeAdminAuthModal();
                updateAdminUIState();
                switchTab('admin-tab');
                showToast("Đăng nhập Admin Tổng!");
                return;
            }

            const matched = workshops.find(w => w.Password && w.Password.toLowerCase() === pass.toLowerCase());
            if (matched) {
                isAdminAuthenticated = true;
                currentAdminRole = 'WORKSHOP_ADMIN';
                currentAdminWorkshop = matched.Name;
                closeAdminAuthModal();
                updateAdminUIState();
                switchTab('admin-tab');
                showToast(`Đăng nhập Admin ${matched.Name}!`);
                return;
            }

            showToast("Mật khẩu không đúng!", "error");
        }

