        function addMaterialToEditingSheet() {
            const sap = prompt("Nhập Mã SAP hoặc Tên vật tư cần thêm:");
            if (!sap) return;
            const currentEditWs = document.getElementById('edit-sheet-workshop')?.value || workshops[0]?.Name;
            const clean = sap.trim().toLowerCase();

            const mat = materials.find(m => m.Workshop === currentEditWs && (m.SapCode.toLowerCase() === clean || m.Name.toLowerCase().includes(clean)));
            if (!mat) {
                showToast(`Không tìm thấy mã [${sap}] trong ${currentEditWs}!`, "error");
                return;
            }

            const defaultMach = machines.find(m => m.Workshop === currentEditWs)?.Name || 'Máy Cắt 1';
            editingSheetItems.push({
                SapCode: mat.SapCode,
                Name: mat.Name,
                Category: mat.Category,
                Workshop: currentEditWs,
                Machine: defaultMach,
                Quantity: 1,
                Tubes: 1,
                Note: ""
            });
            renderEditingSheetItems();
        }

