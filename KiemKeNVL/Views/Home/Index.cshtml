@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi" class="overflow-x-hidden w-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Hệ Thống Kiểm Kê Nguyên Vật Liệu - ASP.NET MVC</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

        *, ::before, ::after {
            box-sizing: border-box;
        }

        html, body {
            font-family: 'Inter', sans-serif;
            touch-action: manipulation;
            overflow-x: hidden !important;
            max-width: 100vw !important;
            width: 100vw !important;
            margin: 0;
            padding: 0;
        }

        input, select, textarea {
            font-size: 15px !important;
        }

        #qr-reader {
            width: 100% !important;
            border: none !important;
        }

            #qr-reader video {
                width: 100% !important;
                height: 100% !important;
                object-fit: cover !important;
                border-radius: 0.5rem;
            }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen flex flex-col antialiased">

    <!-- Toast Notification -->
    <div id="toast" class="fixed top-3 left-1/2 -translate-x-1/2 bg-slate-900 text-white px-3.5 py-2 rounded-xl shadow-2xl transition-all duration-300 transform -translate-y-20 opacity-0 pointer-events-none flex items-center space-x-2 z-50 text-xs font-semibold">
        <i id="toast-icon" data-lucide="check-circle-2" class="w-4 h-4 text-emerald-400 shrink-0"></i>
        <span id="toast-msg">Thao tác thành công</span>
    </div>

    <!-- Header -->
    <header class="bg-slate-900 text-white shadow-md sticky top-0 z-40 w-full border-b border-slate-800">
        <div class="max-w-5xl mx-auto px-3 h-14 flex justify-between items-center">
            <div class="flex items-center space-x-2">
                <div class="bg-blue-600 p-1.5 rounded-lg shadow"><i data-lucide="boxes" class="w-4 h-4 text-white"></i></div>
                <div>
                    <div class="flex items-center space-x-1">
                        <span class="font-extrabold text-sm tracking-wider">KIỂM KÊ SQL</span>
                        <span class="inline-block w-2 h-2 rounded-full bg-emerald-400"></span>
                    </div>
                    <p class="text-[9px] text-slate-400">ASP.NET MVC 5</p>
                </div>
            </div>
            <nav class="flex items-center space-x-1.5">
                <button onclick="switchTab('user-tab')" id="btn-user-tab" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-blue-600 text-white shadow flex items-center space-x-1">
                    <i data-lucide="clipboard-edit" class="w-3.5 h-3.5"></i><span>Nhập Phiếu</span>
                </button>
                <button onclick="switchTab('history-tab')" id="btn-history-tab" class="px-3 py-1.5 rounded-lg text-xs font-bold text-slate-300 hover:text-white flex items-center space-x-1">
                    <i data-lucide="history" class="w-3.5 h-3.5"></i><span>Nhật Ký</span>
                </button>
                <button onclick="openAdminAuthModal()" id="btn-admin-tab" class="px-2.5 py-1.5 rounded-lg text-xs font-bold bg-amber-500 hover:bg-amber-600 text-slate-950 flex items-center space-x-1">
                    <i data-lucide="shield-check" class="w-3.5 h-3.5"></i><span id="btn-admin-text">Admin</span>
                </button>
            </nav>
        </div>
    </header>

    <main class="flex-grow max-w-5xl w-full mx-auto px-3 py-3.5 space-y-3.5">
        <!-- TAB 1: NHẬP PHIẾU -->
        <section id="user-tab" class="space-y-3.5">
            <div class="bg-white rounded-xl p-3.5 shadow-sm border border-slate-200 space-y-2.5">
                <h2 class="text-xs font-bold text-slate-700 uppercase flex items-center">
                    <i data-lucide="building-2" class="w-3.5 h-3.5 mr-1.5 text-blue-600"></i>1. Thông Tin Phiếu & Phân Xưởng
                </h2>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 text-xs font-medium">
                    <div>
                        <label class="block text-slate-700 mb-1 font-bold">Phân Xưởng <span class="text-red-500">*</span></label>
                        <select id="user-workshop-select" onchange="onUserWorkshopChanged()" class="w-full bg-blue-50/50 border-2 border-blue-400 font-bold text-blue-900 rounded-lg p-2.5 outline-none"></select>
                    </div>
                    <div>
                        <label class="block text-slate-700 mb-1 font-bold">Người Tạo Phiếu <span class="text-red-500">*</span></label>
                        <input type="text" id="user-name" placeholder="Họ và tên / Mã NV" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 font-semibold text-slate-800 outline-none">
                    </div>
                    <div>
                        <label class="block text-slate-700 mb-1 font-bold">Ngày Kiểm Kê <span class="text-red-500">*</span></label>
                        <input type="date" id="user-date" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 font-semibold text-slate-800 outline-none">
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-xl p-4 shadow-sm border border-slate-200 text-center space-y-2.5">
                <h3 class="font-bold text-slate-800 text-sm">2. Quét Mã QR Tem Vật Tư</h3>
                <p class="text-xs text-slate-500">Đang chọn: <b id="lbl-active-workshop" class="text-blue-600">Phân Xưởng Cắt</b></p>
                <button onclick="startQRScanner()" class="w-full bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-bold py-3 px-4 rounded-xl shadow flex items-center justify-center space-x-2">
                    <i data-lucide="camera" class="w-5 h-5"></i><span>BẬT CAMERA QUÉT QR</span>
                </button>
                <div class="pt-2 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-center gap-1.5">
                    <span class="text-xs text-slate-500">Hoặc chọn nhanh từ danh mục:</span>
                    <select id="manual-sap-select" onchange="onManualSAPSelect()" class="bg-slate-100 border border-slate-300 rounded-lg px-2.5 py-1.5 text-xs font-semibold"></select>
                </div>
            </div>

            <!-- Card kết quả quét -->
            <div id="scanned-result-card" class="hidden bg-blue-50 border-2 border-blue-400 rounded-xl p-3.5 space-y-2.5 shadow-sm">
                <div class="flex justify-between items-start">
                    <div>
                        <div class="flex items-center space-x-1.5 mb-1">
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-blue-600 text-white uppercase" id="res-category">NẸP LỚN</span>
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-100 text-indigo-800" id="res-workshop">Phân Xưởng Cắt</span>
                        </div>
                        <h4 class="font-bold text-slate-900 text-sm" id="res-name">Tên hàng</h4>
                        <p class="text-xs font-mono text-slate-600">Mã SAP: <span class="font-bold text-blue-700" id="res-sap">400009293</span></p>
                    </div>
                    <span class="bg-emerald-100 text-emerald-800 text-[11px] font-bold px-2 py-1 rounded-lg border border-emerald-300">Đã nhận diện</span>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-800 uppercase mb-1">1. Chọn Máy / Vị Trí <span class="text-red-500">*</span></label>
                    <select id="input-machine" onchange="onMachineSelectChange()" class="w-full bg-white border border-slate-300 rounded-lg p-2 text-xs font-bold"></select>
                </div>
                <div id="input-fields-container" class="hidden space-y-2">
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase mb-1">2. Số Lượng <span class="text-red-500">*</span></label>
                            <input type="number" step="0.01" min="0" id="input-qty" placeholder="0.0" class="w-full bg-white border border-slate-300 rounded-lg p-2 text-sm font-bold">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase mb-1">3. Số Ống/Cuộn</label>
                            <input type="number" min="0" id="input-tubes" placeholder="0" class="w-full bg-white border border-slate-300 rounded-lg p-2 text-sm font-bold">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Ghi Chú</label>
                        <input type="text" id="input-note" placeholder="Nhập ghi chú..." class="w-full bg-white border border-slate-300 rounded-lg p-2 text-xs">
                    </div>
                    <div class="flex space-x-2 pt-1">
                        <button onclick="cancelScanItem()" class="w-1/3 bg-slate-200 text-slate-700 font-bold py-2 rounded-lg text-xs">Hủy</button>
                        <button onclick="addScannedItemToList()" class="w-2/3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2 rounded-lg text-xs shadow">THÊM VÀO PHIẾU</button>
                    </div>
                </div>
            </div>

            <!-- Bảng vật tư trong phiếu -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="p-3 bg-slate-100 border-b border-slate-200 flex justify-between items-center">
                    <h3 class="font-bold text-xs uppercase text-slate-700">Vật Tư Trong Phiếu</h3>
                    <span id="current-items-count" class="text-xs font-bold bg-blue-100 text-blue-800 px-2 py-0.5 rounded-full">0 mục</span>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-50 text-slate-500 font-bold uppercase border-b">
                            <tr>
                                <th class="p-2 text-center w-8">STT</th>
                                <th class="p-2">Vật Tư</th>
                                <th class="p-2">Máy</th>
                                <th class="p-2">SL</th>
                                <th class="p-2">Ống</th>
                                <th class="p-2 text-center w-8">Xóa</th>
                            </tr>
                        </thead>
                        <tbody id="current-items-tbody" class="divide-y divide-slate-100">
                            <tr><td colspan="6" class="p-4 text-center text-slate-400 italic">Chưa có dữ liệu</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="p-3 bg-slate-50 border-t border-slate-200 flex justify-end">
                    <button onclick="saveFullInventorySheet()" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-xl text-xs sm:text-sm shadow flex items-center justify-center space-x-2">
                        <i data-lucide="save" class="w-4 h-4"></i><span>LƯU PHIẾU VÀO SQL SERVER</span>
                    </button>
                </div>
            </div>
        </section>

        <!-- TAB 2: NHẬT KÝ -->
        <section id="history-tab" class="hidden space-y-3.5">
            <div class="bg-white rounded-xl p-3.5 shadow-sm border border-slate-200 space-y-2.5">
                <div class="flex justify-between items-center border-b pb-2">
                    <h2 class="font-bold text-slate-800 text-sm flex items-center">
                        <i data-lucide="history" class="w-4 h-4 mr-1.5 text-blue-600"></i>Nhật Ký Phiếu Đã Lưu
                    </h2>
                    <button onclick="loadHistoryData()" class="bg-slate-100 hover:bg-slate-200 px-2.5 py-1 text-xs font-bold rounded-lg border">Tải Lại</button>
                </div>
                <div class="overflow-x-auto border rounded-lg">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-100 font-bold text-slate-700 uppercase">
                            <tr>
                                <th class="p-2">Mã Phiếu</th>
                                <th class="p-2">Phân Xưởng</th>
                                <th class="p-2">Ngày</th>
                                <th class="p-2">Người Tạo</th>
                                <th class="p-2 text-center">SL Mục</th>
                                <th class="p-2 text-right">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody id="history-tbody" class="divide-y divide-slate-100"></tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>

    <!-- Modal Camera QR -->
    <div id="qr-modal" class="fixed inset-0 bg-slate-900/85 backdrop-blur-sm hidden items-center justify-center z-50 p-3">
        <div class="bg-slate-900 rounded-2xl w-full max-w-xs overflow-hidden flex flex-col border border-slate-700">
            <div class="bg-slate-800 text-white px-3.5 py-3 flex justify-between items-center">
                <h3 class="font-bold text-xs">Đưa Mã QR Vào Khung</h3>
                <button onclick="stopQRScanner()" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-5 h-5"></i></button>
            </div>
            <div class="p-3 bg-black flex flex-col items-center justify-center min-h-[260px]">
                <div id="qr-reader" class="w-full rounded-lg overflow-hidden min-h-[240px]"></div>
            </div>
        </div>
    </div>

    <script>
        let workshops = [];
        let categories = [];
        let machines = [];
        let materials = [];
        let currentSheetItems = [];
        let html5QrCodeScanner = null;

        function getDeviceId() {
            let id = localStorage.getItem('app_device_id');
            if (!id) {
                id = 'DEV-' + Math.random().toString(36).substring(2, 8).toUpperCase();
                localStorage.setItem('app_device_id', id);
            }
            return id;
        }

        document.addEventListener('DOMContentLoaded', async () => {
            document.getElementById('user-date').value = new Date().toISOString().split('T')[0];
            await loadInitialData();
            lucide.createIcons();
        });

        async function loadInitialData() {
            try {
                const res = await fetch('/Home/GetInitialData');
                const data = await res.json();
                if (data.success) {
                    workshops = data.workshops;
                    categories = data.categories;
                    machines = data.machines;
                    materials = data.materials;
                    renderDropdowns();
                }
            } catch (e) {
                showToast("Lỗi kết nối cơ sở dữ liệu!", "error");
            }
        }

        function renderDropdowns() {
            const userWs = document.getElementById('user-workshop-select');
            userWs.innerHTML = workshops.map(w => `<option value="${w.Name}">${w.Name}</option>`).join('');
            onUserWorkshopChanged();
        }

        function onUserWorkshopChanged() {
            const currentWs = document.getElementById('user-workshop-select').value;
            document.getElementById('lbl-active-workshop').innerText = currentWs;

            const manualSelect = document.getElementById('manual-sap-select');
            const filtered = materials.filter(m => m.Workshop === currentWs);
            manualSelect.innerHTML = `<option value="">-- Chọn nhanh --</option>` +
                filtered.map(m => `<option value="${m.SapCode}">[${m.SapCode}] ${m.Name}</option>`).join('');

            const machSelect = document.getElementById('input-machine');
            const filteredMach = machines.filter(m => m.Workshop === currentWs);
            machSelect.innerHTML = `<option value="">-- Chọn Máy/Vị Trí --</option>` +
                filteredMach.map(m => `<option value="${m.Name}">${m.Name}</option>`).join('');
        }

        function startQRScanner() {
            const modal = document.getElementById('qr-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');

            html5QrCodeScanner = new Html5Qrcode("qr-reader");
            html5QrCodeScanner.start(
                { facingMode: "environment" },
                { fps: 15, qrbox: 250 },
                (decodedText) => {
                    stopQRScanner();
                    processScannedCode(decodedText);
                },
                (err) => {}
            ).catch(err => {
                showToast("Không mở được camera", "error");
                stopQRScanner();
            });
        }

        function stopQRScanner() {
            if (html5QrCodeScanner) {
                html5QrCodeScanner.stop().then(() => {
                    html5QrCodeScanner.clear();
                    html5QrCodeScanner = null;
                }).catch(() => { html5QrCodeScanner = null; });
            }
            document.getElementById('qr-modal').classList.add('hidden');
            document.getElementById('qr-modal').classList.remove('flex');
        }

        function onManualSAPSelect() {
            const sap = document.getElementById('manual-sap-select').value;
            if (sap) processScannedCode(sap);
        }

        let currentScannedItem = null;
        function processScannedCode(code) {
            const ws = document.getElementById('user-workshop-select').value;
            const mat = materials.find(m => m.Workshop === ws && (m.SapCode === code || m.Name.toLowerCase().includes(code.toLowerCase())));

            if (mat) {
                currentScannedItem = mat;
                document.getElementById('res-category').innerText = mat.Category;
                document.getElementById('res-workshop').innerText = mat.Workshop;
                document.getElementById('res-name').innerText = mat.Name;
                document.getElementById('res-sap').innerText = mat.SapCode;
                document.getElementById('scanned-result-card').classList.remove('hidden');
            } else {
                showToast(`Không tìm thấy mã [${code}] trong phân xưởng!`, "error");
            }
        }

        function onMachineSelectChange() {
            const val = document.getElementById('input-machine').value;
            document.getElementById('input-fields-container').className = val ? "space-y-2" : "hidden space-y-2";
        }

        function cancelScanItem() {
            currentScannedItem = null;
            document.getElementById('scanned-result-card').classList.add('hidden');
        }

        function addScannedItemToList() {
            const mach = document.getElementById('input-machine').value;
            const qty = parseFloat(document.getElementById('input-qty').value) || 0;
            const tubes = parseInt(document.getElementById('input-tubes').value) || 0;
            const note = document.getElementById('input-note').value;

            if (!mach) { showToast("Vui lòng chọn máy!", "error"); return; }
            if (qty <= 0 && tubes <= 0) { showToast("Vui lòng nhập SL hoặc Ống!", "error"); return; }

            currentSheetItems.push({
                sapCode: currentScannedItem.SapCode,
                name: currentScannedItem.Name,
                category: currentScannedItem.Category,
                workshop: currentScannedItem.Workshop,
                machine: mach,
                quantity: qty,
                tubes: tubes,
                note: note
            });

            renderCurrentSheetItems();
            cancelScanItem();
            showToast("Đã thêm vào phiếu!");
        }

        function renderCurrentSheetItems() {
            const tbody = document.getElementById('current-items-tbody');
            document.getElementById('current-items-count').innerText = `${currentSheetItems.length} mục`;

            if (currentSheetItems.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="p-4 text-center text-slate-400 italic">Chưa có dữ liệu</td></tr>`;
                return;
            }

            tbody.innerHTML = currentSheetItems.map((it, idx) => `
                <tr class="hover:bg-slate-50">
                    <td class="p-2 text-center font-bold text-slate-400">${idx + 1}</td>
                    <td class="p-2 font-bold text-slate-800">${it.name}<br><span class="text-[10px] font-mono text-blue-600">${it.sapCode}</span></td>
                    <td class="p-2">${it.machine}</td>
                    <td class="p-2 font-bold text-emerald-600">${it.quantity}</td>
                    <td class="p-2 font-bold text-blue-600">${it.tubes}</td>
                    <td class="p-2 text-center"><button onclick="currentSheetItems.splice(${idx},1);renderCurrentSheetItems();" class="text-red-500 font-bold">&times;</button></td>
                </tr>
            `).join('');
        }

        async function saveFullInventorySheet() {
            const userName = document.getElementById('user-name').value.trim();
            if (!userName) { showToast("Nhập tên người tạo phiếu!", "error"); return; }
            if (currentSheetItems.length === 0) { showToast("Chưa có vật tư nào!", "error"); return; }

            const payload = {
                workshop: document.getElementById('user-workshop-select').value,
                deviceId: getDeviceId(),
                date: document.getElementById('user-date').value,
                createdBy: userName,
                items: currentSheetItems
            };

            const res = await fetch('/Home/SaveFullInventorySheet', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (data.success) {
                showToast(data.message);
                currentSheetItems = [];
                renderCurrentSheetItems();
                switchTab('history-tab');
            } else {
                showToast(data.message, "error");
            }
        }

        async function loadHistoryData() {
            const res = await fetch(`/Home/GetHistory?deviceId=${getDeviceId()}`);
            const json = await res.json();
            const tbody = document.getElementById('history-tbody');
            if (json.success && json.data.length > 0) {
                tbody.innerHTML = json.data.map(r => `
                    <tr class="hover:bg-slate-50">
                        <td class="p-2 font-mono font-bold text-blue-600">${r.Id}</td>
                        <td class="p-2">${r.Workshop}</td>
                        <td class="p-2">${r.Date}</td>
                        <td class="p-2 font-semibold">${r.CreatedBy}</td>
                        <td class="p-2 text-center font-bold">${r.ItemsCount}</td>
                        <td class="p-2 text-right">
                            <button onclick="deleteSheet('${r.Id}')" class="text-red-500 font-bold underline">Xóa</button>
                        </td>
                    </tr>
                `).join('');
            } else {
                tbody.innerHTML = `<tr><td colspan="6" class="p-4 text-center text-slate-400 italic">Không có phiếu nào</td></tr>`;
            }
        }

        async function deleteSheet(id) {
            if (!confirm(`Xóa phiếu [${id}]?`)) return;
            const res = await fetch('/Home/DeleteSheet', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id })
            });
            const data = await res.json();
            showToast(data.message);
            loadHistoryData();
        }

        function switchTab(tabId) {
            document.getElementById('user-tab').classList.toggle('hidden', tabId !== 'user-tab');
            document.getElementById('history-tab').classList.toggle('hidden', tabId !== 'history-tab');
            if (tabId === 'history-tab') loadHistoryData();
        }

        function showToast(msg, type = "success") {
            const toast = document.getElementById('toast');
            document.getElementById('toast-msg').innerText = msg;
            toast.className = `fixed top-3 left-1/2 -translate-x-1/2 ${type === 'error' ? 'bg-red-600' : 'bg-slate-900'} text-white px-3.5 py-2 rounded-xl shadow-2xl transition-all duration-300 transform translate-y-0 opacity-100 flex items-center space-x-2 z-50 text-xs font-semibold`;
            setTimeout(() => {
                toast.className = "fixed top-3 left-1/2 -translate-x-1/2 bg-slate-900 text-white px-3.5 py-2 rounded-xl shadow-2xl transition-all duration-300 transform -translate-y-20 opacity-0 pointer-events-none flex items-center space-x-2 z-50 text-xs font-semibold";
            }, 2000);
        }
    </script>
</body>
</html>