    <div id="add-machine-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm hidden items-center justify-center z-50 p-3">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-xs overflow-hidden">
            <div class="bg-indigo-900 px-3.5 py-2.5 text-white flex justify-between items-center">
                <h3 class="font-bold text-xs">Thêm Máy / Dây Chuyền</h3>
                <button onclick="document.getElementById('add-machine-modal').classList.add('hidden')" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-4 h-4"></i></button>
            </div>
            <form onsubmit="saveNewMachineAdmin(event)" class="p-3.5 space-y-3 text-xs">
                <div id="container-modal-mach-workshop">
                    <label class="block font-bold text-slate-600 mb-1">Thuộc Phân Xưởng</label>
                    <select id="modal-mach-workshop" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2 font-bold outline-none"></select>
                </div>
                <div>
                    <label class="block font-bold text-slate-600 mb-1">Tên Máy / Vị Trí</label>
                    <input type="text" id="modal-machine-name" required placeholder="Ví dụ: Máy May 1" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2 font-bold outline-none">
                </div>
                <div class="pt-1 flex justify-end space-x-2">
                    <button type="button" onclick="document.getElementById('add-machine-modal').classList.add('hidden')" class="px-3 py-1.5 border rounded-lg font-bold">Hủy</button>
                    <button type="submit" class="px-3 py-1.5 bg-indigo-600 text-white rounded-lg font-bold">Lưu</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal Thêm / Chỉnh Sửa Mã SAP -->
    <div id="add-material-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm hidden items-center justify-center z-50 p-3">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-xs overflow-hidden">
            <div class="bg-slate-900 px-3.5 py-2.5 text-white flex justify-between items-center">
                <h3 id="modal-material-title" class="font-bold text-xs">Thêm Mã SAP</h3>
                <button onclick="closeAddMaterialModal()" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-4 h-4"></i></button>
            </div>
            <form onsubmit="saveMaterialMasterForm(event)" class="p-3.5 space-y-2.5 text-xs">
                <div id="container-modal-mat-workshop">
                    <label class="block font-bold text-slate-600 mb-1">Phân Xưởng <span class="text-red-500">*</span></label>
                    <select id="modal-mat-workshop" onchange="onModalMaterialWorkshopChange()" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2 font-semibold outline-none"></select>
                </div>
                <div>
                    <label class="block font-bold text-slate-600 mb-1">Mã SAP <span class="text-red-500">*</span></label>
                    <input type="text" id="modal-sap-input" required placeholder="400009293" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2 font-mono outline-none">
                </div>
                <div>
                    <label class="block font-bold text-slate-600 mb-1">Tên Vật Tư <span class="text-red-500">*</span></label>
                    <input type="text" id="modal-name-input" required placeholder="Nẹp lớn ghép màng mờ" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2 outline-none">
                </div>
                <div>
                    <label class="block font-bold text-slate-600 mb-1">Quy Cách / Mô Tả</label>
                    <input type="text" id="modal-desc-input" placeholder="TR-NL-50-GMM-TRA-0-XK..." class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2 font-mono outline-none">
                </div>
                <div>
                    <label class="block font-bold text-slate-600 mb-1">Danh Mục <span class="text-red-500">*</span></label>
                    <select id="modal-cat-input" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2 outline-none"></select>
                </div>
                <div>
                    <label class="block font-bold text-slate-600 mb-1">Bí Danh / Tên QR (ngăn cách bằng dấu phẩy)</label>
                    <input type="text" id="modal-alias-input" placeholder="NL GMM TRA, NL MO" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2 outline-none">
                </div>
                <div class="pt-1 flex justify-end space-x-2">
                    <button type="button" onclick="closeAddMaterialModal()" class="px-3 py-1.5 border rounded-lg font-bold">Hủy</button>
                    <button type="submit" class="px-3 py-1.5 bg-blue-600 text-white rounded-lg font-bold">Lưu</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        let workshops = [];
        let categories = [];
        let machines = [];
        let materials = [];
        let currentSheetItems = [];
        let historyRecords = [];
        let html5QrCodeScanner = null;
        let audioCtx = null;

        let isAdminAuthenticated = false;
        let currentAdminRole = null;
        let currentAdminWorkshop = null;

        let currentScannedMaterial = null;
        let pendingUnmappedQRText = "";

        let editingSheetId = null;
        let editingSheetItems = [];
        let editingMaterialSAP = null;

        function getDeviceId() {
            let id = localStorage.getItem('app_device_id');
            if (!id) {
                id = 'DEV-' + Math.random().toString(36).substring(2, 8).toUpperCase();
                localStorage.setItem('app_device_id', id);
            }
            return id;
        }

        document.addEventListener('DOMContentLoaded', async () => {
            document.getElementById('user-date').value = new Date().toISOString().split('T')[0];
            await loadInitialData();
            lucide.createIcons();
        });

        function initOrUnlockAudio() {
            try {
                if (!audioCtx) {
                    const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                    if (AudioContextClass) audioCtx = new AudioContextClass();
                }
                if (audioCtx && audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }
            } catch (e) { }
        }

        function playBeepSound() {
            try {
                initOrUnlockAudio();
                if (!audioCtx) return;

                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();

                osc.type = 'sine';
                osc.frequency.setValueAtTime(1000, audioCtx.currentTime);

                gain.gain.setValueAtTime(0.25, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.12);

                osc.connect(gain);
                gain.connect(audioCtx.destination);

                osc.start();
                osc.stop(audioCtx.currentTime + 0.12);
            } catch (e) { }
        }

        function triggerVibration() {
            try {
                if ("vibrate" in navigator) {
                    navigator.vibrate(100);
                }
            } catch (e) { }
        }

        async function loadInitialData() {
            try {
                const res = await fetch('/Home/GetInitialData');
                const data = await res.json();
                if (data.success) {
                    workshops = data.workshops || [];
                    categories = data.categories || [];
                    machines = data.machines || [];
                    materials = data.materials || [];
                    renderDropdowns();
                }
            } catch (e) {
                showToast("Lỗi kết nối cơ sở dữ liệu!", "error");
            }
        }

        function renderDropdowns() {
            const userWs = document.getElementById('user-workshop-select');
            const histWs = document.getElementById('history-workshop-filter');
            const adminWs = document.getElementById('admin-workshop-filter');
            const adminCatWs = document.getElementById('admin-cat-workshop-filter');
            const adminMachWs = document.getElementById('admin-mach-workshop-filter');
            const modalCatWs = document.getElementById('modal-cat-workshop');
            const modalMachWs = document.getElementById('modal-mach-workshop');
            const modalMatWs = document.getElementById('modal-mat-workshop');

            const wsOptions = workshops.map(w => `<option value="${w.Name}">${w.Name}</option>`).join('');
            const wsOptionsAll = `<option value="ALL">-- Tất Cả Phân Xưởng --</option>` + wsOptions;

            if (userWs) userWs.innerHTML = wsOptions;
            if (histWs) histWs.innerHTML = wsOptionsAll;
            if (adminWs) adminWs.innerHTML = wsOptionsAll;
            if (adminCatWs) adminCatWs.innerHTML = wsOptionsAll;
            if (adminMachWs) adminMachWs.innerHTML = wsOptionsAll;
            if (modalCatWs) modalCatWs.innerHTML = wsOptions;
            if (modalMachWs) modalMachWs.innerHTML = wsOptions;
            if (modalMatWs) modalMatWs.innerHTML = wsOptions;

            onUserWorkshopChanged();
            updateAdminUIState();
        }

        function onUserWorkshopChanged() {
            const userWs = document.getElementById('user-workshop-select');
            const currentWs = userWs ? userWs.value : (workshops[0]?.Name || "Phân Xưởng Cắt");
            document.getElementById('lbl-active-workshop').innerText = currentWs;

            const manualSelect = document.getElementById('manual-sap-select');
            const filtered = materials.filter(m => m.Workshop === currentWs);
            if (manualSelect) {
                manualSelect.innerHTML = `<option value="">-- Chọn nhanh --</option>` +
                    filtered.map(m => `<option value="${m.SapCode}">[${m.SapCode}] ${m.Name}</option>`).join('');
            }

            const machSelect = document.getElementById('input-machine');
            const filteredMach = machines.filter(m => m.Workshop === currentWs);
            if (machSelect) {
                machSelect.innerHTML = `<option value="">-- Chọn Máy/Vị Trí --</option>` +
                    filteredMach.map(m => `<option value="${m.Name}">${m.Name}</option>`).join('');
            }
        }

        function startQRScanner() {
            initOrUnlockAudio();
            const modal = document.getElementById('qr-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');

            html5QrCodeScanner = new Html5Qrcode("qr-reader");
            html5QrCodeScanner.start(
                { facingMode: "environment" },
                { fps: 15, qrbox: 250 },
                (decodedText) => {
                    playBeepSound();
                    triggerVibration();
                    stopQRScanner();
                    processScannedSAPCode(decodedText);
                },
                (err) => { }
            ).catch(err => {
                showToast("Không mở được camera", "error");
                stopQRScanner();
            });
        }

        function stopQRScanner() {
            if (html5QrCodeScanner) {
                html5QrCodeScanner.stop().then(() => {
                    html5QrCodeScanner.clear();
                    html5QrCodeScanner = null;
                }).catch(() => { html5QrCodeScanner = null; });
            }
            document.getElementById('qr-modal').classList.add('hidden');
            document.getElementById('qr-modal').classList.remove('flex');
        }

        function removeDiacritics(str) {
            if (!str) return '';
            return str.toString().toLowerCase()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .replace(/đ/g, 'd').replace(/Đ/g, 'd')
                .trim();
        }

        function onManualSAPSelect() {
            const select = document.getElementById('manual-sap-select');
            if (!select) return;
            const sap = select.value;
            if (sap) processScannedSAPCode(sap);
        }

        function processScannedSAPCode(rawText) {
            if (!rawText) return;
            const cleanText = rawText.toString().trim();
            if (!cleanText) return;

            const currentWs = document.getElementById('user-workshop-select')?.value || (workshops[0]?.Name || "Phân Xưởng Cắt");
            const normClean = removeDiacritics(cleanText);
            const normCleanNoSpace = normClean.replace(/[^a-z0-9]/g, '');

            let workshopMaterials = materials.filter(m => !m.Workshop || m.Workshop === currentWs);

            let matchedMaterial = workshopMaterials.find(m => {
                if (m.SapCode && m.SapCode.toLowerCase() === cleanText.toLowerCase()) return true;
                if (m.Name && removeDiacritics(m.Name) === normClean) return true;
                if (m.Description && removeDiacritics(m.Description) === normClean) return true;

                if (Array.isArray(m.Aliases)) {
                    for (let a of m.Aliases) {
                        if (removeDiacritics(a) === normClean) return true;
                        if (removeDiacritics(a).replace(/[^a-z0-9]/g, '') === normCleanNoSpace) return true;
                    }
                }
                return false;
            });

            if (!matchedMaterial) {
                const digitsOnly = cleanText.replace(/\D/g, '');
                if (digitsOnly.length >= 4) {
                    matchedMaterial = workshopMaterials.find(m => m.SapCode === digitsOnly);
                }
            }

            if (matchedMaterial) {
                displayRecognizedMaterial(matchedMaterial, cleanText);
            } else {
                pendingUnmappedQRText = cleanText;
                document.getElementById('unmapped-raw-text').innerText = cleanText;

                const wsSelect = document.getElementById('map-target-workshop');
                wsSelect.innerHTML = workshops.map(w => `<option value="${w.Name}" ${w.Name === currentWs ? 'selected' : ''}>${w.Name}</option>`).join('');

                onMapWorkshopChange();
                document.getElementById('map-new-sap').value = cleanText.length <= 20 ? cleanText : '';
                document.getElementById('map-new-name').value = '';
                document.getElementById('map-new-desc').value = '';

                document.getElementById('unmapped-qr-modal').classList.remove('hidden');
                document.getElementById('unmapped-qr-modal').classList.add('flex');
            }
        }

        function onMapWorkshopChange() {
            const ws = document.getElementById('map-target-workshop').value;
            const catSelect = document.getElementById('map-target-category');
            const filteredCats = categories.filter(c => c.Workshop === ws);
            if (catSelect) {
                catSelect.innerHTML = filteredCats.map(c => `<option value="${c.Name}">${c.Name}</option>`).join('');
            }
        }

        async function saveNewMaterialFromQR(e) {
            e.preventDefault();
            const ws = document.getElementById('map-target-workshop').value;
            const sapCode = document.getElementById('map-new-sap').value.trim();
            const name = document.getElementById('map-new-name').value.trim();
            const description = document.getElementById('map-new-desc').value.trim();
            const category = document.getElementById('map-target-category').value;

            if (!sapCode || !name || !ws) {
                showToast("Vui lòng điền đủ Phân xưởng, Mã SAP và Tên vật tư!", "error");
                return;
            }

            const payload = {
                SapCode: sapCode,
                Name: name,
                Description: description,
                Category: category,
                Workshop: ws,
                Aliases: `${name}, ${pendingUnmappedQRText}`
            };

            const res = await fetch('/Home/SaveMaterial', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();

            if (data.success) {
                showToast(`Đã tạo và gán mã thành công cho ${ws}!`);
                closeUnmappedModal();
                await loadInitialData();

                const newMat = materials.find(m => m.SapCode === sapCode && m.Workshop === ws);
                if (newMat) {
                    displayRecognizedMaterial(newMat, pendingUnmappedQRText);
                }
            } else {
                showToast(data.message, "error");
            }
        }

        function displayRecognizedMaterial(mat, qrRawText) {
            if (!mat) return;
            currentScannedMaterial = mat;

            const currentWs = mat.Workshop || document.getElementById('user-workshop-select')?.value;

            document.getElementById('res-category').innerText = mat.Category || 'N/A';
            document.getElementById('res-workshop').innerText = currentWs;
            document.getElementById('res-name').innerText = mat.Name || 'N/A';
            document.getElementById('res-sap').innerText = mat.SapCode || 'N/A';
            document.getElementById('res-desc').innerText = mat.Description || 'N/A';
            document.getElementById('res-qr-raw').innerText = qrRawText || mat.Name;

            const machineSelect = document.getElementById('input-machine');
            if (machineSelect) {
                const filteredMachs = machines.filter(m => !m.Workshop || m.Workshop === currentWs);
                machineSelect.innerHTML = `<option value="">-- Chọn Máy / Vị Trí (${currentWs}) --</option>` +
                    filteredMachs.map(m => `<option value="${m.Name}">${m.Name}</option>`).join('');
                machineSelect.value = "";
            }

            document.getElementById('input-fields-container').classList.add('hidden');
            document.getElementById('input-qty').value = '';
            document.getElementById('input-tubes').value = '';
            document.getElementById('input-note').value = '';

            const card = document.getElementById('scanned-result-card');
            card.classList.remove('hidden');
            try { card.scrollIntoView({ behavior: 'smooth', block: 'center' }); } catch (e) { }
        }

        function closeUnmappedModal() {
            document.getElementById('unmapped-qr-modal').classList.add('hidden');
            document.getElementById('unmapped-qr-modal').classList.remove('flex');
        }

        function onMachineSelectChange() {
            const val = document.getElementById('input-machine').value;
            document.getElementById('input-fields-container').className = val ? "space-y-2.5 pt-1" : "hidden space-y-2.5 pt-1";
        }

        function cancelScanItem() {
            currentScannedMaterial = null;
            document.getElementById('scanned-result-card').classList.add('hidden');
        }

        function addScannedItemToList() {
            if (!currentScannedMaterial) return;

            const mach = document.getElementById('input-machine').value;
            const qty = parseFloat(document.getElementById('input-qty').value) || 0;
            const tubes = parseInt(document.getElementById('input-tubes').value) || 0;
            const note = document.getElementById('input-note').value;

            if (!mach) { showToast("Vui lòng chọn máy!", "error"); return; }
            if (qty <= 0 && tubes <= 0) { showToast("Vui lòng nhập SL hoặc Ống!", "error"); return; }

            currentSheetItems.push({
                SapCode: currentScannedMaterial.SapCode,
                Name: currentScannedMaterial.Name,
                Category: currentScannedMaterial.Category,
                Workshop: currentScannedMaterial.Workshop,
                Machine: mach,
                Quantity: qty,
                Tubes: tubes,
                Note: note
            });

            renderCurrentSheetItems();
            cancelScanItem();
            showToast("Đã thêm vào phiếu!");
        }

        function renderCurrentSheetItems() {
            const tbody = document.getElementById('current-items-tbody');
            document.getElementById('current-items-count').innerText = `${currentSheetItems.length} mục`;

            if (currentSheetItems.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="p-4 text-center text-slate-400 italic">Chưa có dữ liệu</td></tr>`;
                return;
            }

            tbody.innerHTML = currentSheetItems.map((it, idx) => `
                    <tr class="hover:bg-slate-50">
                        <td class="p-2 text-center font-bold text-slate-400">${idx + 1}</td>
                        <td class="p-2 font-bold text-slate-800">${it.Name}<br><span class="text-[10px] font-mono text-blue-600">${it.SapCode}</span></td>
                        <td class="p-2">${it.Machine}</td>
                        <td class="p-2 font-bold text-emerald-600">${it.Quantity}</td>
                        <td class="p-2 font-bold text-blue-600">${it.Tubes}</td>
                        <td class="p-2 text-center"><button onclick="currentSheetItems.splice(${idx},1);renderCurrentSheetItems();" class="text-red-500 font-bold">&times;</button></td>
                    </tr>
                `).join('');
        }

        async function saveFullInventorySheet() {
            const userName = document.getElementById('user-name').value.trim();
            if (!userName) { showToast("Nhập tên người tạo phiếu!", "error"); return; }
            if (currentSheetItems.length === 0) { showToast("Chưa có vật tư nào!", "error"); return; }

            const payload = {
                Workshop: document.getElementById('user-workshop-select').value,
                DeviceId: getDeviceId(),
                Date: document.getElementById('user-date').value,
                CreatedBy: userName,
                Items: currentSheetItems
            };

            const res = await fetch('/Home/SaveFullInventorySheet', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (data.success) {
                showToast(data.message);
                currentSheetItems = [];
                renderCurrentSheetItems();
                switchTab('history-tab');
            } else {
                showToast(data.message, "error");
            }
        }

        async function loadHistoryData() {
            const ws = document.getElementById('history-workshop-filter')?.value || "ALL";
            const from = document.getElementById('history-from-date')?.value || "";
            const to = document.getElementById('history-to-date')?.value || "";

            const url = `/Home/GetHistory?fromDate=${from}&toDate=${to}&workshopFilter=${ws}&deviceId=${getDeviceId()}&isAdmin=${isAdminAuthenticated}&adminRole=${currentAdminRole || ''}&adminWorkshop=${currentAdminWorkshop || ''}`;
            const res = await fetch(url);
            const json = await res.json();
            const tbody = document.getElementById('history-tbody');
            const countBadge = document.getElementById('displayed-sheets-count');

            historyRecords = (json.success && json.data) ? json.data : [];

            if (historyRecords.length > 0) {
                if (countBadge) countBadge.innerText = historyRecords.length;
                tbody.innerHTML = historyRecords.map(r => {
                    const canModify = isAdminAuthenticated && (currentAdminRole === 'SUPER_ADMIN' || (currentAdminRole === 'WORKSHOP_ADMIN' && r.Workshop === currentAdminWorkshop));

                    return `
                            <tr class="hover:bg-slate-50 transition">
                                <td class="p-2 font-mono font-bold text-blue-600">${r.Id}</td>
                                <td class="p-2"><span class="px-1.5 py-0.5 rounded bg-blue-50 text-blue-800 text-[10px] font-bold border border-blue-200">${r.Workshop}</span></td>
                                <td class="p-2">${r.Date}</td>
                                <td class="p-2"><span class="px-1.5 py-0.5 rounded bg-slate-100 text-[10px] font-bold border">${r.Machine || 'N/A'}</span></td>
                                <td class="p-2 font-semibold text-slate-700">${r.CreatedBy}</td>
                                <td class="p-2 text-center font-bold">${r.ItemsCount}</td>
                                <td class="p-2 text-right">
                                    <div class="flex items-center justify-end space-x-2">
                                        <button onclick="viewHistoryDetail('${r.Id}')" class="text-blue-600 hover:text-blue-800 font-bold text-xs underline">Xem</button>
                                        ${canModify ? `
                                            <button onclick="openEditSheetModal('${r.Id}')" class="text-amber-600 hover:text-amber-800 font-bold text-xs underline">Sửa</button>
                                            <button onclick="deleteSheet('${r.Id}')" class="text-red-500 hover:text-red-700 font-bold text-xs underline">Xóa</button>
                                        ` : ''}
                                    </div>
                                </td>
                            </tr>
                        `;
                }).join('');
            } else {
                if (countBadge) countBadge.innerText = 0;
                tbody.innerHTML = `<tr><td colspan="7" class="p-4 text-center text-slate-400 italic">Không có phiếu kiểm kê nào</td></tr>`;
            }
        }

        async function deleteSheet(id) {
            if (!confirm(`Xác nhận xóa phiếu [${id}]?`)) return;
            const res = await fetch('/Home/DeleteSheet', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id })
            });
            const data = await res.json();
            showToast(data.message);
            loadHistoryData();
        }

        async function deleteSheetsByDateRange() {
            if (!isAdminAuthenticated) {
                showToast("Yêu cầu đăng nhập Admin để xóa!", "error");
                return;
            }
            if (!historyRecords || historyRecords.length === 0) {
                showToast("Không tìm thấy phiếu nào để xóa!", "error");
                return;
            }

            if (!confirm(`XÁC NHẬN:\nBạn có chắc chắn muốn xóa vĩnh viễn ${historyRecords.length} phiếu đang xem khỏi cơ sở dữ liệu?`))
                return;

            const sheetIds = historyRecords.map(r => r.Id);
            const res = await fetch('/Home/DeleteBatchSheets', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ sheetIds })
            });
            const data = await res.json();
            showToast(data.message, data.success ? "success" : "error");
            loadHistoryData();
        }

        function setTodayFilter() {
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('history-from-date').value = today;
            document.getElementById('history-to-date').value = today;
            loadHistoryData();
        }

        function clearDateFilter() {
            document.getElementById('history-from-date').value = "";
            document.getElementById('history-to-date').value = "";
            document.getElementById('history-workshop-filter').value = "ALL";
