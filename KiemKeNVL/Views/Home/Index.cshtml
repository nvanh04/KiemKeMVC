        function updateAdminUIState() {
            const roleBadge = document.getElementById('admin-role-badge');
            const adminNavText = document.getElementById('btn-admin-text');
            const wsSection = document.getElementById('admin-workshop-section');
            const bannerText = document.getElementById('history-permission-text');
            const loginTriggerBtn = document.getElementById('btn-history-login-trigger');
            const wsFilterContainer = document.getElementById('container-history-workshop-filter');
            const deleteFilteredBtn = document.getElementById('btn-delete-filtered-sheets');

            const catTitle = document.getElementById('cat-section-title');
            const machTitle = document.getElementById('mach-section-title');
            const matTitle = document.getElementById('mat-section-title');

            const adminWsFilter = document.getElementById('admin-workshop-filter');
            const adminCatWsFilter = document.getElementById('admin-cat-workshop-filter');
            const adminMachWsFilter = document.getElementById('admin-mach-workshop-filter');

            const modalCatWsContainer = document.getElementById('container-modal-cat-workshop');
            const modalMachWsContainer = document.getElementById('container-modal-mach-workshop');
            const modalMatWsContainer = document.getElementById('container-modal-mat-workshop');

            const modalCatWs = document.getElementById('modal-cat-workshop');
            const modalMachWs = document.getElementById('modal-mach-workshop');
            const modalMatWs = document.getElementById('modal-mat-workshop');

            if (isAdminAuthenticated) {
                if (loginTriggerBtn) loginTriggerBtn.classList.add('hidden');
                if (deleteFilteredBtn) deleteFilteredBtn.classList.remove('hidden');

                if (currentAdminRole === 'SUPER_ADMIN') {
                    if (roleBadge) roleBadge.innerText = "Admin Tổng (Toàn Quyền Toàn Nhà Máy)";
                    if (adminNavText) adminNavText.innerText = "Admin Tổng";
                    if (wsSection) wsSection.classList.remove('hidden');
                    if (bannerText) bannerText.innerText = "Admin Tổng: Đang quản lý toàn bộ phiếu toàn nhà máy.";
                    if (wsFilterContainer) wsFilterContainer.classList.remove('hidden');

                    if (catTitle) catTitle.innerText = "2. Quản Lý Danh Mục Vật Tư";
                    if (machTitle) machTitle.innerText = "3. Quản Lý Máy / Vị Trí";
                    if (matTitle) matTitle.innerText = "4. Danh Mục Mã SAP";

                    if (adminWsFilter) { adminWsFilter.classList.remove('hidden'); adminWsFilter.disabled = false; }
                    if (adminCatWsFilter) { adminCatWsFilter.classList.remove('hidden'); adminCatWsFilter.disabled = false; }
                    if (adminMachWsFilter) { adminMachWsFilter.classList.remove('hidden'); adminMachWsFilter.disabled = false; }

                    if (modalCatWsContainer) modalCatWsContainer.classList.remove('hidden');
                    if (modalMachWsContainer) modalMachWsContainer.classList.remove('hidden');
                    if (modalMatWsContainer) modalMatWsContainer.classList.remove('hidden');

                    if (modalCatWs) modalCatWs.disabled = false;
                    if (modalMachWs) modalMachWs.disabled = false;
                    if (modalMatWs) modalMatWs.disabled = false;
                } else {
                    if (roleBadge) roleBadge.innerText = `Admin: ${currentAdminWorkshop}`;
                    if (adminNavText) adminNavText.innerText = currentAdminWorkshop.replace("Phân Xưởng", "").trim();
                    if (wsSection) wsSection.classList.add('hidden');
                    if (bannerText) bannerText.innerText = `Admin ${currentAdminWorkshop}: Quản lý phiếu của ${currentAdminWorkshop}.`;
                    if (wsFilterContainer) wsFilterContainer.classList.add('hidden');

                    if (catTitle) catTitle.innerText = `1. Danh Mục Vật Tư (${currentAdminWorkshop})`;
                    if (machTitle) machTitle.innerText = `2. Máy & Vị Trí (${currentAdminWorkshop})`;
                    if (matTitle) matTitle.innerText = `3. Mã SAP (${currentAdminWorkshop})`;

                    if (adminWsFilter) { adminWsFilter.value = currentAdminWorkshop; adminWsFilter.classList.add('hidden'); }
                    if (adminCatWsFilter) { adminCatWsFilter.value = currentAdminWorkshop; adminCatWsFilter.classList.add('hidden'); }
                    if (adminMachWsFilter) { adminMachWsFilter.value = currentAdminWorkshop; adminMachWsFilter.classList.add('hidden'); }

                    if (modalCatWs) modalCatWs.value = currentAdminWorkshop;
                    if (modalMachWs) modalMachWs.value = currentAdminWorkshop;
                    if (modalMatWs) modalMatWs.value = currentAdminWorkshop;

                    if (modalCatWsContainer) modalCatWsContainer.classList.add('hidden');
                    if (modalMachWsContainer) modalMachWsContainer.classList.add('hidden');
                    if (modalMatWsContainer) modalMatWsContainer.classList.add('hidden');
                }
            } else {
                if (loginTriggerBtn) loginTriggerBtn.classList.remove('hidden');
                if (deleteFilteredBtn) deleteFilteredBtn.classList.add('hidden');
                if (adminNavText) adminNavText.innerText = "Admin";
                if (bannerText) bannerText.innerText = "Chế độ Thiết Bị: Hiển thị các phiếu máy này vừa nhập.";
                if (wsFilterContainer) wsFilterContainer.classList.add('hidden');
            }

            renderAdminWorkshopsChips();
            renderAdminCategoriesChips();
            renderAdminMachinesChips();
            renderAdminCategoryFilterDropdown();
            renderAdminMaterialsTable();
            lucide.createIcons();
        }

        function renderAdminWorkshopsChips() {
            const container = document.getElementById('admin-workshops-chips');
            if (!container) return;
            if (currentAdminRole === 'SUPER_ADMIN') {
                container.innerHTML = workshops.map(w => `
                        <div class="bg-slate-50 border border-slate-200 rounded-lg p-2 flex justify-between items-center text-xs">
                            <div class="truncate mr-1">
                                <div class="font-bold text-slate-800 truncate">${w.Name}</div>
                                <div class="text-[10px] text-blue-700 font-mono mt-0.5">Mật khẩu: <b class="bg-blue-100 text-blue-900 px-1 rounded">${w.Password}</b></div>
                            </div>
                            <button onclick="deleteWorkshopAdmin('${w.Name}')" class="text-red-500 hover:text-red-700 p-1 shrink-0" title="Xóa phân xưởng">
                                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                    `).join('');
            } else {
                container.innerHTML = '';
            }
        }

        function renderAdminCategoriesChips() {
            let filterWs = document.getElementById('admin-cat-workshop-filter')?.value || 'ALL';
            if (currentAdminRole === 'WORKSHOP_ADMIN' && currentAdminWorkshop) {
                filterWs = currentAdminWorkshop;
            }

            const container = document.getElementById('admin-categories-chips');
            if (!container) return;

            const filtered = categories.filter(c => filterWs === 'ALL' || c.Workshop === filterWs);
            container.innerHTML = filtered.map(c => {
                const canDelete = (currentAdminRole === 'SUPER_ADMIN') || (currentAdminRole === 'WORKSHOP_ADMIN' && c.Workshop === currentAdminWorkshop);
                return `
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                            ${c.Name} ${currentAdminRole === 'SUPER_ADMIN' ? `<span class="text-[10px] text-emerald-600 ml-1 font-normal">(${c.Workshop})</span>` : ''}
                            ${canDelete ? `<button onclick="deleteCategoryAdmin('${c.Name}', '${c.Workshop}')" class="ml-1.5 text-slate-400 hover:text-red-600 font-bold">&times;</button>` : ''}
                        </span>
                    `;
            }).join('');
        }

        function renderAdminMachinesChips() {
            let filterWs = document.getElementById('admin-mach-workshop-filter')?.value || 'ALL';
            if (currentAdminRole === 'WORKSHOP_ADMIN' && currentAdminWorkshop) {
                filterWs = currentAdminWorkshop;
            }

            const container = document.getElementById('admin-machines-chips');
            if (!container) return;

            const filtered = machines.filter(m => filterWs === 'ALL' || m.Workshop === filterWs);
            container.innerHTML = filtered.map(m => {
                const canDelete = (currentAdminRole === 'SUPER_ADMIN') || (currentAdminRole === 'WORKSHOP_ADMIN' && m.Workshop === currentAdminWorkshop);
                return `
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-800 border border-indigo-200">
                            ${m.Name} ${currentAdminRole === 'SUPER_ADMIN' ? `<span class="text-[10px] text-indigo-600 ml-1 font-normal">(${m.Workshop})</span>` : ''}
                            ${canDelete ? `<button onclick="deleteMachineAdmin('${m.Name}', '${m.Workshop}')" class="ml-1.5 text-slate-400 hover:text-red-600 font-bold">&times;</button>` : ''}
                        </span>
                    `;
            }).join('');
        }

        function renderAdminCategoryFilterDropdown() {
            const adminCatFilter = document.getElementById('admin-category-filter');
            if (!adminCatFilter) return;

            let filterWs = document.getElementById('admin-workshop-filter')?.value || 'ALL';
            if (currentAdminRole === 'WORKSHOP_ADMIN' && currentAdminWorkshop) {
                filterWs = currentAdminWorkshop;
            }

            const matchedCats = categories.filter(c => filterWs === 'ALL' || c.Workshop === filterWs);
            const uniqueCats = [...new Set(matchedCats.map(c => c.Name))];

            adminCatFilter.innerHTML = `<option value="ALL">-- Tất cả Danh Mục --</option>` +
                uniqueCats.map(c => `<option value="${c}">${c}</option>`).join('');
        }

        function renderAdminMaterialsTable() {
            const tbody = document.getElementById('admin-materials-tbody');
            const search = document.getElementById('admin-search-input')?.value.toLowerCase().trim() || "";
            let filterWs = document.getElementById('admin-workshop-filter')?.value || "ALL";
            if (currentAdminRole === 'WORKSHOP_ADMIN' && currentAdminWorkshop) {
                filterWs = currentAdminWorkshop;
            }

            const filterCat = document.getElementById('admin-category-filter')?.value || "ALL";

            const filtered = materials.filter(m => {
                const matchWs = (filterWs === "ALL") || m.Workshop === filterWs;
                const matchCat = (filterCat === "ALL") || m.Category === filterCat;
                const matchSearch = !search ||
                    m.Name.toLowerCase().includes(search) ||
                    m.SapCode.toLowerCase().includes(search) ||
                    (m.Description && m.Description.toLowerCase().includes(search));
                return matchWs && matchCat && matchSearch;
            });

            document.getElementById('admin-materials-count').innerText = filtered.length;
            if (!filtered || filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="p-4 text-center text-slate-400 italic">Không tìm thấy mã SAP nào phù hợp</td></tr>`;
                return;
            }

            tbody.innerHTML = filtered.map(m => {
                const canDelete = (currentAdminRole === 'SUPER_ADMIN') || (currentAdminRole === 'WORKSHOP_ADMIN' && m.Workshop === currentAdminWorkshop);
                return `
                        <tr class="hover:bg-slate-50 transition">
                            <td class="p-2 font-mono font-bold text-blue-700">${m.SapCode}</td>
                            <td class="p-2"><span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-blue-50 text-blue-800 border border-blue-200">${m.Workshop}</span></td>
                            <td class="p-2 font-semibold text-slate-800">${m.Name}</td>
                            <td class="p-2"><span class="px-1.5 py-0.5 rounded text-[10px] font-semibold bg-slate-100 border">${m.Category}</span></td>
                            <td class="p-2 text-center">
                                <button onclick="editMaterialMaster('${m.SapCode}')" class="text-amber-500 hover:text-amber-700 p-1" title="Chỉnh sửa mã SAP">
                                    <i data-lucide="pencil" class="w-4 h-4"></i>
                                </button>
                            </td>
                            <td class="p-2 text-center">
                                ${canDelete ? `
                                    <button onclick="deleteMaterialMaster('${m.SapCode}')" class="text-red-500 hover:text-red-700 p-1" title="Xóa mã SAP">
                                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                                    </button>
                                ` : `<span class="text-slate-300">-</span>`}
                            </td>
                        </tr>
                    `;
            }).join('');
            lucide.createIcons();
        }

        /* ===== QUẢN TRỊ: THÊM / XÓA PHÂN XƯỞNG, DANH MỤC, MÁY ===== */
        function openAddWorkshopModal() {
            if (currentAdminRole !== 'SUPER_ADMIN') {
                showToast("Chỉ Admin Tổng mới có quyền thêm phân xưởng!", "error");
                return;
            }
            document.getElementById('modal-workshop-name').value = '';
            document.getElementById('add-workshop-modal').classList.remove('hidden');
            document.getElementById('add-workshop-modal').classList.add('flex');
        }

        async function saveNewWorkshopAdmin(e) {
            e.preventDefault();
            const name = document.getElementById('modal-workshop-name').value.trim();
            const res = await fetch('/Home/SaveWorkshop', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name })
            });
            const data = await res.json();
            showToast(data.message, data.success ? "success" : "error");
            document.getElementById('add-workshop-modal').classList.add('hidden');
            await loadInitialData();
            updateAdminUIState();
        }

        async function deleteWorkshopAdmin(name) {
            if (currentAdminRole !== 'SUPER_ADMIN') {
                showToast("Chỉ Admin Tổng mới có quyền xóa phân xưởng!", "error");
                return;
            }
            if (!confirm(`Xác nhận xóa phân xưởng "${name}"?`)) return;

            const res = await fetch('/Home/DeleteWorkshop', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name })
            });
            const data = await res.json();
            showToast(data.message, data.success ? "success" : "error");
            await loadInitialData();
            updateAdminUIState();
        }

        function openAddCategoryModal() {
            document.getElementById('modal-category-name').value = '';
            if (currentAdminRole === 'WORKSHOP_ADMIN' && currentAdminWorkshop) {
                document.getElementById('modal-cat-workshop').value = currentAdminWorkshop;
            }
            document.getElementById('add-category-modal').classList.remove('hidden');
            document.getElementById('add-category-modal').classList.add('flex');
        }

        async function saveNewCategoryAdmin(e) {
            e.preventDefault();
            const name = document.getElementById('modal-category-name').value.trim();
            const workshop = (currentAdminRole === 'WORKSHOP_ADMIN' && currentAdminWorkshop)
                ? currentAdminWorkshop
                : document.getElementById('modal-cat-workshop').value;

            const res = await fetch('/Home/SaveCategory', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name, workshop })
            });
            const data = await res.json();
            showToast(data.message, data.success ? "success" : "error");
            document.getElementById('add-category-modal').classList.add('hidden');
            await loadInitialData();
            updateAdminUIState();
        }

        async function deleteCategoryAdmin(name, workshop) {
            if (currentAdminRole === 'WORKSHOP_ADMIN' && workshop !== currentAdminWorkshop) {
                showToast("Bạn không có quyền xóa danh mục của xưởng khác!", "error");
                return;
            }
            if (!confirm(`Xác nhận xóa danh mục "${name}"?`)) return;

            const res = await fetch('/Home/DeleteCategory', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name, workshop })
            });
            const data = await res.json();
            showToast(data.message, data.success ? "success" : "error");
            await loadInitialData();
            updateAdminUIState();
        }

        function openAddMachineModal() {
            document.getElementById('modal-machine-name').value = '';
            if (currentAdminRole === 'WORKSHOP_ADMIN' && currentAdminWorkshop) {
                document.getElementById('modal-mach-workshop').value = currentAdminWorkshop;
            }
            document.getElementById('add-machine-modal').classList.remove('hidden');
            document.getElementById('add-machine-modal').classList.add('flex');
        }

        async function saveNewMachineAdmin(e) {
            e.preventDefault();
            const name = document.getElementById('modal-machine-name').value.trim();
            const workshop = (currentAdminRole === 'WORKSHOP_ADMIN' && currentAdminWorkshop)
                ? currentAdminWorkshop
                : document.getElementById('modal-mach-workshop').value;

            const res = await fetch('/Home/SaveMachine', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name, workshop })
            });
            const data = await res.json();
            showToast(data.message, data.success ? "success" : "error");
            document.getElementById('add-machine-modal').classList.add('hidden');
            await loadInitialData();
            updateAdminUIState();
        }

        async function deleteMachineAdmin(name, workshop) {
            if (currentAdminRole === 'WORKSHOP_ADMIN' && workshop !== currentAdminWorkshop) {
                showToast("Bạn không có quyền xóa máy của xưởng khác!", "error");
                return;
            }
            if (!confirm(`Xác nhận xóa máy "${name}"?`)) return;

            const res = await fetch('/Home/DeleteMachine', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name, workshop })
            });
            const data = await res.json();
            showToast(data.message, data.success ? "success" : "error");
            await loadInitialData();
            updateAdminUIState();
        }

        /* ===== QUẢN TRỊ: THÊM / SỬA / XÓA MÃ SAP ===== */
        function openAddMaterialModal() {
            editingMaterialSAP = null;
            document.getElementById('modal-material-title').innerText = 'Thêm Mã SAP';
            document.getElementById('modal-sap-input').value = '';
            document.getElementById('modal-name-input').value = '';
            document.getElementById('modal-desc-input').value = '';
            document.getElementById('modal-alias-input').value = '';

            if (currentAdminRole === 'WORKSHOP_ADMIN' && currentAdminWorkshop) {
                document.getElementById('modal-mat-workshop').value = currentAdminWorkshop;
            }

            onModalMaterialWorkshopChange();
            document.getElementById('add-material-modal').classList.remove('hidden');
            document.getElementById('add-material-modal').classList.add('flex');
        }

        function closeAddMaterialModal() {
            editingMaterialSAP = null;
            document.getElementById('add-material-modal').classList.add('hidden');
            document.getElementById('add-material-modal').classList.remove('flex');
        }

        function onModalMaterialWorkshopChange() {
            const modalMatWs = (currentAdminRole === 'WORKSHOP_ADMIN' && currentAdminWorkshop)
                ? currentAdminWorkshop
                : (document.getElementById('modal-mat-workshop')?.value || workshops[0]?.Name || 'Phân Xưởng Cắt');

            const catSelect = document.getElementById('modal-cat-input');
            const filteredCats = categories.filter(c => c.Workshop === modalMatWs);
            if (catSelect) {
                catSelect.innerHTML = filteredCats.map(c => `<option value="${c.Name}">${c.Name}</option>`).join('');
            }
        }

        function editMaterialMaster(sapCode) {
            const mat = materials.find(m => m.SapCode === sapCode);
            if (!mat) return;

            editingMaterialSAP = sapCode;
            document.getElementById('modal-material-title').innerText = 'Chỉnh Sửa Mã SAP';
            document.getElementById('modal-sap-input').value = mat.SapCode;
            document.getElementById('modal-name-input').value = mat.Name;
            document.getElementById('modal-desc-input').value = mat.Description || '';
            document.getElementById('modal-alias-input').value = Array.isArray(mat.Aliases) ? mat.Aliases.join(', ') : '';

            document.getElementById('modal-mat-workshop').value = mat.Workshop;
            onModalMaterialWorkshopChange();

            setTimeout(() => {
                document.getElementById('modal-cat-input').value = mat.Category;
            }, 50);

            document.getElementById('add-material-modal').classList.remove('hidden');
            document.getElementById('add-material-modal').classList.add('flex');
        }

        async function saveMaterialMasterForm(e) {
            e.preventDefault();
            const sapCode = document.getElementById('modal-sap-input').value.trim();
            const name = document.getElementById('modal-name-input').value.trim();
            const desc = document.getElementById('modal-desc-input').value.trim();
            const ws = (currentAdminRole === 'WORKSHOP_ADMIN' && currentAdminWorkshop)
                ? currentAdminWorkshop
                : document.getElementById('modal-mat-workshop').value;
            const category = document.getElementById('modal-cat-input').value;
            const aliases = document.getElementById('modal-alias-input').value.trim();

            const payload = {
                OriginalSapCode: editingMaterialSAP,
                SapCode: sapCode,
                Name: name,
                Description: desc,
                Category: category,
                Workshop: ws,
                Aliases: aliases
            };

            const res = await fetch('/Home/SaveMaterial', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            showToast(data.message, data.success ? "success" : "error");
            closeAddMaterialModal();
            await loadInitialData();
            updateAdminUIState();
        }

        async function deleteMaterialMaster(sapCode) {
            const mat = materials.find(m => m.SapCode === sapCode);
            if (!mat) return;

            if (currentAdminRole === 'WORKSHOP_ADMIN' && mat.Workshop !== currentAdminWorkshop) {
                showToast("Bạn không có quyền xóa mã SAP của xưởng khác!", "error");
                return;
            }

            if (!confirm(`Xác nhận xóa vĩnh viễn mã SAP [${sapCode}] - "${mat.Name}"?`)) return;

            const res = await fetch('/Home/DeleteMaterial', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ sapCode: mat.SapCode, workshop: mat.Workshop })
            });
            const data = await res.json();
            showToast(data.message, data.success ? "success" : "error");
            await loadInitialData();
            updateAdminUIState();
        }

        async function deleteAllMaterialsAdmin() {
            const ws = (currentAdminRole === 'WORKSHOP_ADMIN' && currentAdminWorkshop) ? currentAdminWorkshop : (document.getElementById('admin-workshop-filter')?.value || "ALL");
            if (!confirm(`XÁC NHẬN:\nBạn có muốn xóa toàn bộ mã nguyên vật liệu${ws === "ALL" ? " của toàn nhà máy" : " trong " + ws} không?`)) return;

            const res = await fetch('/Home/DeleteAllMaterials', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ workshop: ws })
            });
            const data = await res.json();
            showToast(data.message, data.success ? "success" : "error");
            await loadInitialData();
            updateAdminUIState();
        }

        async function deleteAllMachinesAdmin() {
            const ws = (currentAdminRole === 'WORKSHOP_ADMIN' && currentAdminWorkshop) ? currentAdminWorkshop : (document.getElementById('admin-workshop-filter')?.value || "ALL");
            if (!confirm(`XÁC NHẬN:\nBạn có muốn xóa toàn bộ máy/vị trí${ws === "ALL" ? " của toàn nhà máy" : " trong " + ws} không?`)) return;

            const res = await fetch('/Home/DeleteAllMachines', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ workshop: ws })
            });
            const data = await res.json();
            showToast(data.message, data.success ? "success" : "error");
            await loadInitialData();
            updateAdminUIState();
        }

        async function deleteAllCategoriesAdmin() {
            const ws = (currentAdminRole === 'WORKSHOP_ADMIN' && currentAdminWorkshop) ? currentAdminWorkshop : (document.getElementById('admin-workshop-filter')?.value || "ALL");
            if (!confirm(`XÁC NHẬN:\nBạn có muốn xóa toàn bộ danh mục vật tư${ws === "ALL" ? " của toàn nhà máy" : " trong " + ws} không?`)) return;

            const res = await fetch('/Home/DeleteAllCategories', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ workshop: ws })
            });
            const data = await res.json();
            showToast(data.message, data.success ? "success" : "error");
            await loadInitialData();
            updateAdminUIState();
        }

        function switchTab(tabId) {
            document.getElementById('user-tab').classList.add('hidden');
            document.getElementById('history-tab').classList.add('hidden');
            document.getElementById('admin-tab').classList.add('hidden');

            document.getElementById('btn-user-tab').className = "px-2 sm:px-3 py-1.5 rounded-lg text-xs font-bold transition text-slate-300 hover:text-white flex items-center space-x-1";
            document.getElementById('btn-history-tab').className = "px-2 sm:px-3 py-1.5 rounded-lg text-xs font-bold transition text-slate-300 hover:text-white flex items-center space-x-1";

            if (tabId === 'user-tab') {
                document.getElementById('user-tab').classList.remove('hidden');
                document.getElementById('btn-user-tab').className = "px-2 sm:px-3 py-1.5 rounded-lg text-xs font-bold transition bg-blue-600 text-white shadow flex items-center space-x-1";
            } else if (tabId === 'history-tab') {
                document.getElementById('history-tab').classList.remove('hidden');
                document.getElementById('btn-history-tab').className = "px-2 sm:px-3 py-1.5 rounded-lg text-xs font-bold transition bg-blue-600 text-white shadow flex items-center space-x-1";
                updateAdminUIState();
                loadHistoryData();
            } else if (tabId === 'admin-tab') {
                document.getElementById('admin-tab').classList.remove('hidden');
                updateAdminUIState();
            }
        }

        function showToast(msg, type = "success") {
            const toast = document.getElementById('toast');
            document.getElementById('toast-msg').innerText = msg;
            toast.className = `fixed top-3 left-1/2 -translate-x-1/2 ${type === 'error' ? 'bg-red-600' : 'bg-slate-900'} text-white px-3.5 py-2 rounded-xl shadow-2xl transition-all duration-300 transform translate-y-0 opacity-100 flex items-center space-x-2 z-50 text-xs font-semibold max-w-[92vw]`;
            setTimeout(() => {
                toast.className = "fixed top-3 left-1/2 -translate-x-1/2 bg-slate-900 text-white px-3.5 py-2 rounded-xl shadow-2xl transition-all duration-300 transform -translate-y-20 opacity-0 pointer-events-none flex items-center space-x-2 z-50 text-xs font-semibold max-w-[92vw]";
            }, 2000);
        }
    </script>
</body>
</html>