                                <span class="text-[10px] text-slate-500 font-semibold">Máy/Vị Trí</span>
                                <select onchange="editingSheetItems[${idx}].Machine = this.value" class="w-full bg-white border border-slate-300 rounded p-1 text-xs font-bold">
