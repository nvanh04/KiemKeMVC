        function handleExcelImport(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = async function (e) {
                try {
                    const data = new Uint8Array(e.target.result);
                    const workbook = XLSX.read(data, { type: 'array' });
                    const sheet = workbook.Sheets[workbook.SheetNames[0]];
                    const rows = XLSX.utils.sheet_to_json(sheet, { defval: "" });

                    if (!rows || rows.length === 0) {
                        showToast("File Excel không có dữ liệu!", "error");
                        return;
                    }

                    const importList = [];
                    rows.forEach(row => {
                        const sap = (row["Mã SAP"] || row["SAP"] || row["Ma SAP"] || row["MÃ SAP"] || "").toString().trim();
                        const name = (row["Tên Vật Tư"] || row["Tên Hàng"] || row["Ten Vat Tu"] || row["TÊN VẬT TƯ"] || "").toString().trim();
                        let ws = (row["Phân Xưởng"] || row["Xưởng"] || row["PHÂN XƯỞNG"] || "Phân Xưởng Cắt").toString().trim();

                        if (currentAdminRole === 'WORKSHOP_ADMIN' && currentAdminWorkshop) {
                            ws = currentAdminWorkshop;
                        }

                        const cat = (row["Danh Mục"] || row["Loại"] || row["DANH MỤC"] || "KHÁC").toString().trim().toUpperCase();
                        const desc = (row["Mô Tả Quy Cách"] || row["Mô Tả"] || row["Quy Cách"] || "").toString().trim();
                        const aliases = (row["Tên Khác / Bí Danh QR"] || row["Bí Danh"] || "").toString().trim();

                        if (sap && name) {
                            importList.push({
                                SapCode: sap,
                                Name: name,
                                Workshop: ws,
                                Category: cat,
                                Description: desc,
                                Aliases: aliases
                            });
                        }
                    });

                    if (importList.length === 0) {
                        showToast("Không tìm thấy dòng vật tư hợp lệ nào trong file!", "error");
                        return;
                    }

                    showToast(`Đang nhập ${importList.length} vật tư vào SQL Server...`);

                    const res = await fetch('/Home/SaveBatchMaterials', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ materials: importList })
                    });
                    const resData = await res.json();
                    showToast(resData.message, resData.success ? "success" : "error");

                    await loadInitialData();
                    updateAdminUIState();
                } catch (err) {
                    showToast("Lỗi đọc file Excel Mã SAP!", "error");
                } finally {
                    event.target.value = "";
                }
            };
            reader.readAsArrayBuffer(file);
        }

