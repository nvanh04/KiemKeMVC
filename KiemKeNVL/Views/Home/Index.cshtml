@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi" class="overflow-x-hidden w-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Hệ Thống Kiểm Kê Nguyên Vật Liệu</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

        *, ::before, ::after {
            box-sizing: border-box;
        }

        html, body {
            font-family: 'Inter', sans-serif;
            touch-action: manipulation;
            overflow-x: hidden !important;
            max-width: 100vw !important;
            width: 100vw !important;
            margin: 0;
            padding: 0;
        }

        input, select, textarea {
            font-size: 15px !important;
        }

        ::-webkit-scrollbar {
            height: 4px;
            width: 4px;
        }

        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }

        #qr-reader {
            width: 100% !important;
            border: none !important;
        }

            #qr-reader video {
                width: 100% !important;
                height: 100% !important;
                object-fit: cover !important;
                border-radius: 0.5rem;
            }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen flex flex-col antialiased">

    <!-- Toast Notification -->
    <div id="toast" class="fixed top-3 left-1/2 -translate-x-1/2 bg-slate-900 text-white px-3.5 py-2 rounded-xl shadow-2xl transition-all duration-300 transform -translate-y-20 opacity-0 pointer-events-none flex items-center space-x-2 z-50 text-xs font-semibold max-w-[92vw]">
        <i id="toast-icon" data-lucide="check-circle-2" class="w-4 h-4 text-emerald-400 shrink-0"></i>
        <span id="toast-msg">Thao tác thành công</span>
    </div>

    <!-- Topbar -->
    <header class="bg-slate-900 text-white shadow-md sticky top-0 z-40 w-full border-b border-slate-800">
        <div class="max-w-5xl mx-auto px-2 sm:px-4 h-14 flex justify-between items-center w-full">
            <div class="flex items-center space-x-1.5 shrink-0">
                <div class="bg-blue-600 p-1.5 rounded-lg shadow shrink-0">
                    <i data-lucide="boxes" class="w-4 h-4 text-white"></i>
                </div>
                <div>
                    <div class="flex items-center space-x-1">
                        <span class="font-extrabold text-sm tracking-wider text-white">KIỂM KÊ SQL</span>
                        <span class="inline-block w-2 h-2 rounded-full bg-emerald-400"></span>
                    </div>
                    <p class="text-[9px] text-slate-400">ASP.NET MVC 5</p>
                </div>
            </div>

            <nav class="flex items-center space-x-1 sm:space-x-1.5 shrink-0">
                <button onclick="switchTab('user-tab')" id="btn-user-tab" class="px-2 sm:px-3 py-1.5 rounded-lg text-xs font-bold transition bg-blue-600 text-white shadow flex items-center space-x-1">
                    <i data-lucide="clipboard-edit" class="w-3.5 h-3.5"></i>
                    <span>Nhập Phiếu</span>
                </button>
                <button onclick="switchTab('history-tab')" id="btn-history-tab" class="px-2 sm:px-3 py-1.5 rounded-lg text-xs font-bold transition text-slate-300 hover:text-white flex items-center space-x-1">
                    <i data-lucide="history" class="w-3.5 h-3.5"></i>
                    <span>Nhật Ký</span>
                </button>
                <button onclick="openAdminAuthModal()" id="btn-admin-tab" class="px-2 sm:px-2.5 py-1.5 rounded-lg text-xs font-bold transition bg-amber-500 hover:bg-amber-600 text-slate-950 flex items-center space-x-1 shadow-sm">
                    <i data-lucide="shield-check" class="w-3.5 h-3.5 text-slate-950"></i>
                    <span id="btn-admin-text">Admin</span>
                </button>
            </nav>
        </div>
    </header>

    <main class="flex-grow max-w-5xl w-full mx-auto px-2.5 sm:px-4 py-3 sm:py-4 space-y-3.5">

        <!-- TAB 1: NHẬP PHIẾU KIỂM KÊ -->
        <section id="user-tab" class="space-y-3.5 w-full">
            <div class="bg-white rounded-xl p-3 sm:p-4 shadow-sm border border-slate-200 space-y-2.5">
                <h2 class="text-xs font-bold text-slate-700 uppercase tracking-wider flex items-center">
                    <i data-lucide="building-2" class="w-3.5 h-3.5 mr-1.5 text-blue-600"></i>
                    1. Thông Tin Phiếu & Phân Xưởng
                </h2>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 text-xs font-medium">
                    <div>
                        <label class="block text-slate-700 mb-1 font-bold">Phân Xưởng <span class="text-red-500">*</span></label>
                        <select id="user-workshop-select" onchange="onUserWorkshopChanged()" class="w-full bg-blue-50/50 border-2 border-blue-400 font-bold text-blue-900 rounded-lg p-2.5 outline-none"></select>
                    </div>
                    <div>
                        <label class="block text-slate-700 mb-1 font-bold">Người Tạo Phiếu <span class="text-red-500">*</span></label>
                        <input type="text" id="user-name" placeholder="Họ và tên / Mã NV" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 outline-none font-semibold text-slate-800">
                    </div>
                    <div>
                        <label class="block text-slate-700 mb-1 font-bold">Ngày Kiểm Kê <span class="text-red-500">*</span></label>
                        <input type="date" id="user-date" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 outline-none font-semibold text-slate-800">
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-xl p-3.5 sm:p-5 shadow-sm border border-slate-200 text-center space-y-2.5">
                <h3 class="font-bold text-slate-800 text-sm sm:text-base">2. Quét Mã QR Tem Vật Tư</h3>
                <p class="text-xs text-slate-500">Đang chọn: <b id="lbl-active-workshop" class="text-blue-600">Phân Xưởng Cắt</b></p>
                <button onclick="startQRScanner()" class="w-full bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 text-white font-bold py-3 px-4 rounded-xl shadow flex items-center justify-center space-x-2">
                    <i data-lucide="camera" class="w-5 h-5"></i>
                    <span class="text-xs sm:text-sm uppercase tracking-wide">BẬT CAMERA QUÉT QR</span>
                </button>
                <div class="pt-2 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-center gap-1.5">
                    <span class="text-xs text-slate-500">Hoặc chọn nhanh từ danh mục:</span>
                    <select id="manual-sap-select" onchange="onManualSAPSelect()" class="bg-slate-100 border border-slate-300 rounded-lg px-2.5 py-2 text-xs font-semibold"></select>
                </div>
            </div>

            <!-- Card kết quả quét -->
            <div id="scanned-result-card" class="hidden bg-blue-50 border-2 border-blue-400 rounded-xl p-3 sm:p-4 space-y-2.5 shadow-sm">
                <div class="flex justify-between items-start gap-2">
                    <div>
                        <div class="flex items-center space-x-1.5 mb-1">
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-blue-600 text-white uppercase" id="res-category">NẸP NHỎ</span>
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-100 text-indigo-800 border border-indigo-200" id="res-workshop">Phân Xưởng Cắt</span>
                        </div>
                        <h4 class="font-bold text-slate-900 text-sm mt-0.5" id="res-name">Tên hàng</h4>
                        <p class="text-xs font-mono text-slate-600 mt-0.5">Mã SAP: <span class="font-bold text-blue-700" id="res-sap">400009033</span></p>
                        <p class="text-xs text-slate-500 mt-0.5 truncate">Quy cách: <span class="font-mono" id="res-desc">N/A</span></p>
                        <p class="text-[11px] text-slate-600 mt-0.5 truncate">Dữ liệu quét: "<span id="res-qr-raw">N/A</span>"</p>
                    </div>
                    <span class="bg-emerald-100 text-emerald-800 text-[11px] font-bold px-2 py-1 rounded-lg border border-emerald-300 shrink-0">Đã nhận diện</span>
                </div>
                <div class="pt-2 border-t border-blue-200">
                    <label class="block text-xs font-bold text-slate-800 uppercase mb-1">1. Chọn Máy / Vị Trí <span class="text-red-500">*</span></label>
                    <select id="input-machine" onchange="onMachineSelectChange()" class="w-full bg-white border border-slate-300 rounded-lg p-2.5 text-xs font-bold text-slate-900 outline-none"></select>
                </div>
                <div id="input-fields-container" class="hidden space-y-2.5 pt-1">
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase mb-1">2. Số Lượng <span class="text-red-500">*</span></label>
                            <input type="number" step="0.01" min="0" id="input-qty" placeholder="0.0" class="w-full bg-white border border-slate-300 rounded-lg p-2 text-sm font-bold outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase mb-1">3. Số Ống/Cuộn</label>
                            <input type="number" min="0" id="input-tubes" placeholder="0" class="w-full bg-white border border-slate-300 rounded-lg p-2 text-sm font-bold outline-none">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Ghi Chú</label>
                        <input type="text" id="input-note" placeholder="Nhập ghi chú..." class="w-full bg-white border border-slate-300 rounded-lg p-2 text-xs outline-none">
                    </div>
                    <div class="flex space-x-2 pt-1">
                        <button onclick="cancelScanItem()" class="w-1/3 bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold py-2 rounded-lg text-xs">Hủy</button>
                        <button onclick="addScannedItemToList()" class="w-2/3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2 rounded-lg text-xs shadow flex items-center justify-center space-x-1">
                            <i data-lucide="plus-circle" class="w-4 h-4"></i>
                            <span>THÊM VÀO PHIẾU</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Bảng vật tư trong phiếu -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="p-2.5 sm:p-3 bg-slate-100 border-b border-slate-200 flex justify-between items-center">
                    <h3 class="font-bold text-xs uppercase text-slate-700 flex items-center space-x-1">
                        <i data-lucide="list-checks" class="w-4 h-4 text-blue-600 mr-1"></i>Vật Tư Trong Phiếu
                    </h3>
                    <span id="current-items-count" class="text-xs font-bold bg-blue-100 text-blue-800 px-2 py-0.5 rounded-full">0 mục</span>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-50 text-slate-500 font-bold uppercase border-b">
                            <tr>
                                <th class="p-2 text-center w-8">STT</th>
                                <th class="p-2">Vật Tư</th>
                                <th class="p-2">Máy/Vị Trí</th>
                                <th class="p-2">SL</th>
                                <th class="p-2">Ống</th>
                                <th class="p-2 text-center w-8">Xóa</th>
                            </tr>
                        </thead>
                        <tbody id="current-items-tbody" class="divide-y divide-slate-100">
                            <tr><td colspan="6" class="p-4 text-center text-slate-400 italic">Chưa có dữ liệu</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="p-2.5 sm:p-3 bg-slate-50 border-t border-slate-200 flex justify-end">
                    <button onclick="saveFullInventorySheet()" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-xl text-xs sm:text-sm shadow flex items-center justify-center space-x-2">
                        <i data-lucide="save" class="w-4 h-4"></i>
                        <span>HOÀN TẤT & LƯU PHIẾU KIỂM KÊ</span>
                    </button>
                </div>
            </div>
        </section>

        <!-- TAB 2: NHẬT KÝ KIỂM KÊ -->
        <section id="history-tab" class="hidden space-y-3.5 w-full">
            <div class="bg-white rounded-xl p-3 sm:p-4 shadow-sm border border-slate-200 space-y-2.5">
                <div id="history-permission-banner" class="bg-slate-800 text-slate-200 p-2.5 rounded-lg flex items-center justify-between text-xs">
                    <div class="flex items-center space-x-2">
                        <i data-lucide="lock" class="w-4 h-4 text-amber-400 shrink-0"></i>
                        <span id="history-permission-text" class="font-semibold">Chế độ Thiết Bị: Hiển thị các phiếu máy này vừa nhập.</span>
                    </div>
                    <button id="btn-history-login-trigger" onclick="openAdminAuthModal()" class="px-2 py-1 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold rounded text-[11px] shrink-0">Đăng Nhập Admin</button>
                </div>

                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 border-b pb-2">
                    <div>
                        <h2 class="font-bold text-slate-800 text-sm flex items-center">
                            <i data-lucide="history" class="w-4 h-4 mr-1.5 text-blue-600"></i>Nhật Ký Phiếu Đã Lưu
                        </h2>
                        <p class="text-xs text-slate-500">Hiển thị: <b id="displayed-sheets-count" class="text-blue-600">0</b> phiếu</p>
                    </div>
                    <div class="flex space-x-2 w-full sm:w-auto">
                        <button onclick="setTodayFilter()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold px-2.5 py-1.5 rounded-lg border">Hôm Nay</button>
                        <button onclick="clearDateFilter()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold px-2.5 py-1.5 rounded-lg border">Tất Cả</button>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-xs font-semibold">
                    <div id="container-history-workshop-filter">
                        <label class="block text-slate-600 mb-1">Phân Xưởng:</label>
                        <select id="history-workshop-filter" onchange="loadHistoryData()" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2 font-bold text-blue-900 outline-none"></select>
                    </div>
                    <div>
                        <label class="block text-slate-600 mb-1">Từ Ngày:</label>
                        <input type="date" id="history-from-date" onchange="loadHistoryData()" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2 font-bold text-slate-800 outline-none">
                    </div>
                    <div>
                        <label class="block text-slate-600 mb-1">Đến Ngày:</label>
                        <input type="date" id="history-to-date" onchange="loadHistoryData()" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2 font-bold text-slate-800 outline-none">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1">
                    <button onclick="exportToExcelByDateRange()" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold py-2.5 px-3 rounded-lg flex items-center justify-center space-x-1.5 shadow transition">
                        <i data-lucide="file-spreadsheet" class="w-4 h-4"></i>
                        <span>XUẤT EXCEL CÁC PHIẾU ĐANG XEM</span>
                    </button>
                    <button id="btn-delete-filtered-sheets" onclick="deleteSheetsByDateRange()" class="hidden w-full bg-red-600 hover:bg-red-700 text-white text-xs font-bold py-2.5 px-3 rounded-lg flex items-center justify-center space-x-1.5 shadow transition">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                        <span>XÓA CÁC PHIẾU ĐANG LỌC</span>
                    </button>
                </div>

                <div class="overflow-x-auto border border-slate-200 rounded-lg mt-2">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-100 font-bold text-slate-700 uppercase">
                            <tr>
                                <th class="p-2">Mã Phiếu</th>
                                <th class="p-2">Phân Xưởng</th>
                                <th class="p-2">Ngày</th>
                                <th class="p-2">Máy</th>
                                <th class="p-2">Người Tạo</th>
                                <th class="p-2 text-center">SL Mục</th>
                                <th class="p-2 text-right">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody id="history-tbody" class="divide-y divide-slate-100"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- TAB 3: TRANG QUẢN TRỊ (ADMIN) -->
        <section id="admin-tab" class="hidden space-y-3.5 w-full">
            <div class="bg-gradient-to-r from-slate-900 to-indigo-950 text-white p-3 rounded-xl shadow flex justify-between items-center">
                <div class="flex items-center space-x-2">
                    <div class="p-1.5 rounded-lg bg-amber-500/20 border border-amber-500/40">
                        <i data-lucide="shield-alert" class="w-4 h-4 text-amber-400"></i>
                    </div>
                    <div>
                        <p class="text-[10px] text-slate-400 font-semibold uppercase">Quyền Truy Cập</p>
                        <p id="admin-role-badge" class="font-bold text-xs sm:text-sm text-amber-300">Admin Tổng Toàn Nhà Máy</p>
                    </div>
                </div>
                <button onclick="logoutAdmin()" class="px-2.5 py-1.5 rounded-lg bg-red-600 hover:bg-red-700 text-white text-xs font-bold flex items-center space-x-1 shadow">
                    <i data-lucide="log-out" class="w-3.5 h-3.5"></i>
                    <span>Đăng Xuất</span>
                </button>
            </div>

            <!-- Mục 1: Phân xưởng -->
            <div id="admin-workshop-section" class="bg-white rounded-xl p-3 sm:p-4 shadow-sm border border-slate-200 space-y-2.5">
                <div class="flex justify-between items-center">
                    <h2 class="font-bold text-slate-800 text-sm flex items-center">
                        <i data-lucide="factory" class="w-4 h-4 mr-1.5 text-blue-600"></i>1. Quản Lý Phân Xưởng (Admin Tổng)
                    </h2>
                    <button onclick="openAddWorkshopModal()" class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold px-2.5 py-1.5 rounded-lg flex items-center space-x-1">
                        <i data-lucide="plus" class="w-3.5 h-3.5"></i><span>Thêm Phân Xưởng</span>
                    </button>
                </div>
                <div id="admin-workshops-chips" class="grid grid-cols-1 sm:grid-cols-3 gap-2 pt-1"></div>
            </div>

            <!-- Mục 2: Danh mục -->
            <div class="bg-white rounded-xl p-3 sm:p-4 shadow-sm border border-slate-200 space-y-2.5">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
                    <h2 class="font-bold text-slate-800 text-sm flex items-center">
                        <i data-lucide="folder-tree" class="w-4 h-4 mr-1.5 text-emerald-600"></i>
                        <span id="cat-section-title">2. Quản Lý Danh Mục Vật Tư</span>
                    </h2>
                    <div class="flex flex-wrap items-center gap-1.5 w-full sm:w-auto">
                        <select id="admin-cat-workshop-filter" onchange="renderAdminCategoriesChips()" class="bg-slate-50 border border-slate-300 rounded-lg px-2 py-1 text-xs font-semibold"></select>

                        <button onclick="downloadCategoryExcelTemplate()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-300 text-xs font-bold px-2.5 py-1.5 rounded-lg flex items-center space-x-1" title="Tải mẫu Excel danh mục">
                            <i data-lucide="download" class="w-3.5 h-3.5 text-emerald-600"></i><span>Tải Mẫu</span>
                        </button>
                        <label for="excel-cat-file-input" class="cursor-pointer bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-bold px-2.5 py-1.5 rounded-lg flex items-center space-x-1 shadow">
                            <i data-lucide="upload" class="w-3.5 h-3.5"></i><span>Nhập Excel</span>
                        </label>
                        <input type="file" id="excel-cat-file-input" accept=".xlsx, .xls, .csv" class="hidden" onchange="handleCategoryExcelImport(event)">

                        <button onclick="openBatchCategoryModal()" class="bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-bold px-2.5 py-1.5 rounded-lg flex items-center space-x-1 shrink-0 shadow">
                            <i data-lucide="layers" class="w-3.5 h-3.5"></i><span>Thêm Hàng Loạt</span>
                        </button>
                        <button onclick="deleteAllCategoriesAdmin()" class="bg-red-50 hover:bg-red-100 text-red-600 border border-red-200 text-xs font-bold px-2.5 py-1.5 rounded-lg flex items-center space-x-1 shrink-0">
                            <i data-lucide="trash-2" class="w-3.5 h-3.5"></i><span>Xóa Tất Cả</span>
                        </button>
                        <button onclick="openAddCategoryModal()" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold px-2.5 py-1.5 rounded-lg flex items-center space-x-1 shrink-0">
                            <i data-lucide="plus" class="w-3.5 h-3.5"></i><span>Thêm</span>
                        </button>
                    </div>
                </div>
                <div id="admin-categories-chips" class="flex flex-wrap gap-1.5 pt-1"></div>
            </div>

            <!-- Mục 3: Máy/Vị trí -->
            <div class="bg-white rounded-xl p-3 sm:p-4 shadow-sm border border-slate-200 space-y-2.5">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
                    <h2 class="font-bold text-slate-800 text-sm flex items-center">
                        <i data-lucide="settings-2" class="w-4 h-4 mr-1.5 text-indigo-600"></i>
                        <span id="mach-section-title">3. Quản Lý Máy / Vị Trí</span>
                    </h2>
                    <div class="flex flex-wrap items-center gap-1.5 w-full sm:w-auto">
                        <select id="admin-mach-workshop-filter" onchange="renderAdminMachinesChips()" class="bg-slate-50 border border-slate-300 rounded-lg px-2 py-1 text-xs font-semibold"></select>

